# Copy to .env and fill in. .env is gitignored; never commit real tokens.

# ── seeder / seedfill (cmd/seeder, cmd/seedfill) ─────────────────────────────
# Memory server base URL (no trailing slash)
MEMORY_SERVER=https://api.dev.emergent-company.ai
# Project API token (emt_…), scope project:admin
MEMORY_PROJECT_TOKEN=emt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Project ID (optional; overrides name-based auto-resolve)
MEMORY_PROJECT_ID=00000000-0000-0000-0000-000000000000
# Directory containing seed/ (default: current directory)
SEED_DIR=.

# ── e2e / eval (tests/e2e, tests/eval) ───────────────────────────────────────
# Aliases of MEMORY_SERVER / MEMORY_PROJECT_TOKEN used by the test suites.
TEST_SERVER_URL=https://api.dev.emergent-company.ai
TEST_API_TOKEN=emt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Required only for the blueprint install test
TEST_PROJECT_ID=00000000-0000-0000-0000-000000000000
