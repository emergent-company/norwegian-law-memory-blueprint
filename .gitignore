# Norwegian Law Memory Blueprint — gitignore

# Compiled binary (the bare name would also match the cmd/seeder/ dir, so be specific)
/seeder
/cmd/seeder/seeder
/seedfill
/cmd/seedfill/seedfill

# Seeder state files (the tracked blueprint seed data lives in seed/ and is NOT ignored)
idmap.json
state.json
rels_done.txt
rels_failed.jsonl

# Local secrets / environment — never commit (keep .env.example)
.env
.env.*
!.env.example

# Temporary data cache
/tmp/

# Evaluation dataset cache and generated output (public but copyrighted PDFs;
# generated dataset is not committed)
/evals/cache/
/evals/dataset/
/evals/results/
/evals/generated/

# OS-generated files
.DS_Store
Thumbs.db

# Editor files
.idea/
.vscode/
*.swp
*.swo
